# Copy to .env and fill in. Never commit .env.
#
# Generate the password hash (the plaintext then never exists on the server):
#   docker compose run --rm simulator python -m wellcontrol.sim.auth
WELLCONTROL_INSTRUCTOR_PASSWORD_HASH=

# Signs student and instructor tokens. Without it a random key is used, which
# means every restart signs the whole class out in the middle of a kill.
#   openssl rand -base64 48
WELLCONTROL_SECRET_KEY=
